#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <300>;
};


/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings = 
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp E>,
                <&macro_release &kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
                &kp Q            &kp W              &kp E                 &kp R                   &kp T                                                  &kp Y        &kp U            &kp I              &kp O               &kp P
                &mt LCTRL A      &mt LALT S         &mt LSHIFT D          &mt LGUI F              &mt LCTRL G                                            &mt RCTRL H  &mt RGUI J       &kp K              &mt RALT L          &lt 3 MINUS
                &kp Z            &kp X              &kp C                 &kp V                   &kp B                                                  &kp N        &kp M            &kp COMMA          &kp DOT             &mt RSHIFT SLASH
                &kp LSHIFT       &kp LALT           &kp TAB               &kp LS(LG(N4))          &lt 2 SPACE       &lt 3 ESC           &lt 3 BACKSPACE  &lt 2 ENTER  &kp LS(LG(N4))   &kp BACKSLASH      &lt 1 RC(SPACE)     &lt 4 F12
            >;
            sensor-bindings = <&encoder_msc SCRL_DOWN SCRL_UP>;
        };

        layer_1 {
            display-name = "Mouse Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &kp RG(LEFT) &kp LG(DOWN)     &kp LG(UP)         &kp RG(RIGHT)       &trans
                &trans           &kp S              &kp D                 &trans                  &kp G                                                  &kp H        &mkp MB1         &mkp MB2           &msc SCRL_UP        &msc SCRL_DOWN
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &mkp MB3
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &kp DOWN           &trans              &kp LG(W)
            >;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
                &trans           &kp NUMBER_7       &kp NUMBER_8          &kp NUMBER_9            &kp EQUAL                                              &kp F1       &kp F2           &kp F7             &kp F10             &kp RSHIFT
                &mt LCTRL NUMBER_8 &mt LALT NUMBER_4 &mt LSHIFT NUMBER_5  &mt LGUI NUMBER_6       &mt LCTRL MINUS                                        &kp LEFT     &mkp MB1         &mkp MB2           &kp RIGHT           &kp SEMICOLON
                &kp SLASH        &kp NUMBER_1       &kp NUMBER_2          &kp NUMBER_3            &kp LS(EQUAL)                                          &kp RA(LEFT) &kp RA(DOWN)     &kp RA(UP)         &kp RA(RIGHT)       &kp RALT
                &trans           &kp DOT            &kp NUMBER_0          &trans                  &kp LANG2         &trans              &trans           &kp LANG1    &trans           &kp RS(RC(TAB))    &kp RC(TAB)         &kp F12
            >;
            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "Mark Layer";
            bindings = <
                &kp LS(LG(N4))   &kp F4             &kp LS(N9)            &kp LS(N0)              &none                                                  &kp LS(GRAVE) &kp LS(N1)      &kp LS(N2)         &kp LS(N3)          &kp LS(N4)
                &emoji           &kp F5             &kp LBKT              &kp RBKT                &none                                                  &kp GRAVE    &kp LS(MINUS)    &kp SQT            &kp LS(SQT)         &kp BSLH
                &kp KP_NUMLOCK   &kp F11            &kp LS(LBKT)          &kp LS(RBKT)            &none                                                  &kp LS(BSLH) &kp LS(N5)       &kp LS(N6)         &kp LS(N7)          &kp LS(N8)
                &trans           &trans             &kp NUMBER_0          &trans                  &kp SPACE         &trans              &trans           &kp ENTER    &trans           &none              &none               &kp F12
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
                &kp F1           &kp F2             &kp F3                &kp F4                  &bt BT_CLR                                             &bt BT_SEL 0 &bt BT_SEL 1     &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_SEL 4
                &mt LCTRL F5     &kp F6             &kp F7                &kp F8                  &sys_reset                                             &kp LEFT     &kp DOWN         &kp UP             &kp RIGHT           &kp DELETE
                &kp F9           &kp F10            &kp F11               &kp F12                 &none                                                  &kp HOME     &kp END          &kp C_VOL_UP       &kp C_VOL_DN        &sys_reset
                &kp LSHIFT       &kp LALT           &kp TAB               &bt BT_CLR_ALL          &bootloader       &none               &studio_unlock   &none        &none            &none              &none               &bootloader
            >;
        };

        layer_5 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
            >;
        };

        layer_6 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
            >;
        };
    };
};
